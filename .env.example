# Turso (libSQL) Configuration
VITE_TURSO_DB_URL=libsql://***REMOVED_TURSO_URL***
VITE_TURSO_AUTH_TOKEN=<turso-auth-token>

# Cloudflare R2 – server-side only (do NOT prefix with VITE_)
# Set these in Vercel Dashboard > Settings > Environment Variables
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET_NAME=<r2-bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Public base URL for serving uploaded images (e.g. https://pub-xxxx.r2.dev or custom domain)
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Optional: secret token to protect the upload endpoint (set the same value in Vercel Dashboard)
# UPLOAD_SECRET=<random-secret>
# VITE_UPLOAD_SECRET=<same-random-secret>
